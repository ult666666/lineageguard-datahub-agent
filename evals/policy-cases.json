{
  "schema": "lineageguard.policy-cases/1",
  "about": "Labelled schema-change review cases. Labels follow the rules in docs/EVALUATION.md, not the current policy output. Run: npm run studio:benchmark",
  "world": {
    "target": "urn:li:dataset:(urn:li:dataPlatform:snowflake,prod.sales.orders,PROD)",
    "name": "prod.sales.orders",
    "platform": "snowflake",
    "fields": [
      { "name": "order_id", "type": "BIGINT", "nullable": false },
      { "name": "order_total", "type": "DECIMAL(12,2)", "nullable": false },
      { "name": "customer_id", "type": "BIGINT", "nullable": true },
      { "name": "quantity", "type": "INT", "nullable": false },
      { "name": "status", "type": "VARCHAR(32)", "nullable": true },
      { "name": "status_code", "type": "CHAR(2)", "nullable": true },
      { "name": "discount_rate", "type": "FLOAT", "nullable": true },
      { "name": "is_test", "type": "BOOLEAN", "nullable": true },
      { "name": "created_at", "type": "TIMESTAMP", "nullable": false },
      { "name": "updated_at", "type": "TIMESTAMP(3)", "nullable": true },
      { "name": "order_date", "type": "DATE", "nullable": false }
    ],
    "nodes": [
      {
        "id": "orders",
        "urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,prod.sales.orders,PROD)",
        "name": "orders",
        "type": "dataset",
        "owner": "Commerce Data"
      },
      {
        "id": "revenue",
        "urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,prod.finance.fct_revenue,PROD)",
        "name": "fct_revenue",
        "type": "dataset",
        "owner": "Finance Analytics"
      },
      {
        "id": "dashboard",
        "urn": "urn:li:dashboard:(looker,revenue_overview)",
        "name": "Revenue overview",
        "type": "dashboard",
        "owner": "Finance Analytics"
      },
      {
        "id": "close",
        "urn": "urn:li:dataJob:(urn:li:dataFlow:(airflow,finance_close,PROD),monthly_close)",
        "name": "Monthly close",
        "type": "pipeline",
        "owner": "Finance Operations"
      },
      {
        "id": "forecast",
        "urn": "urn:li:mlModel:(urn:li:dataPlatform:sagemaker,demand_forecast,PROD)",
        "name": "Demand forecast",
        "type": "model",
        "owner": "Applied ML"
      }
    ],
    "edges": [
      { "from": "orders", "to": "revenue", "level": "table" },
      { "from": "revenue", "to": "dashboard", "level": "table" },
      { "from": "revenue", "to": "close", "level": "table" },
      { "from": "orders", "to": "forecast", "level": "table" }
    ],
    "paths": [
      {
        "from": "orders.order_total",
        "to": "fct_revenue.gross_amount",
        "level": "column",
        "hops": ["orders.order_total", "fct_revenue.gross_amount"]
      },
      {
        "from": "fct_revenue.gross_amount",
        "to": "revenue_overview.revenue",
        "level": "column",
        "hops": ["fct_revenue.gross_amount", "revenue_overview.revenue"]
      }
    ],
    "weeklyQueries": 120
  },
  "cases": [
    {
      "id": "add-optional-column",
      "group": "compatibility",
      "rationale": "A new nullable column leaves every existing contract intact.",
      "changes": [{ "kind": "add", "field": "campaign_id", "type": "VARCHAR(64)", "required": false }],
      "expected": { "decision": "proceed-with-checks", "reasons": ["ADDITIVE_CHANGE"], "gaps": [] }
    },
    {
      "id": "add-column-required-omitted",
      "group": "compatibility",
      "rationale": "Without required=true the column is nullable, so this is still additive.",
      "changes": [{ "kind": "add", "field": "channel", "type": "VARCHAR(16)" }],
      "expected": { "decision": "proceed-with-checks", "reasons": ["ADDITIVE_CHANGE"], "gaps": [] }
    },
    {
      "id": "add-required-column",
      "group": "compatibility",
      "rationale": "A NOT NULL column cannot be added to existing rows without a validated backfill.",
      "changes": [{ "kind": "add", "field": "region", "type": "VARCHAR(16)", "required": true }],
      "expected": { "decision": "block", "reasons": ["REQUIRED_WITHOUT_BACKFILL"], "gaps": [] }
    },
    {
      "id": "add-existing-column",
      "group": "compatibility",
      "rationale": "The column already exists; the DDL would fail.",
      "changes": [{ "kind": "add", "field": "status", "type": "VARCHAR(64)", "required": false }],
      "expected": { "decision": "block", "reasons": ["FIELD_EXISTS"], "gaps": [] }
    },
    {
      "id": "add-existing-column-uppercase",
      "group": "compatibility",
      "rationale": "Unquoted identifiers are case-insensitive, so STATUS is the existing status column.",
      "changes": [{ "kind": "add", "field": "STATUS", "type": "VARCHAR(64)", "required": false }],
      "expected": { "decision": "block", "reasons": ["FIELD_EXISTS"], "gaps": [] }
    },
    {
      "id": "add-existing-column-mixed-case",
      "group": "compatibility",
      "rationale": "Order_Total resolves to the existing order_total column.",
      "changes": [{ "kind": "add", "field": "Order_Total", "type": "DECIMAL(14,2)", "required": false }],
      "expected": { "decision": "block", "reasons": ["FIELD_EXISTS"], "gaps": [] }
    },
    {
      "id": "drop-column",
      "group": "compatibility",
      "rationale": "Dropping a column removes a contract that consumers may read.",
      "changes": [{ "kind": "drop", "field": "status" }],
      "expected": { "decision": "block", "reasons": ["DESTRUCTIVE_CHANGE"], "gaps": [] }
    },
    {
      "id": "drop-unknown-column",
      "group": "compatibility",
      "rationale": "The request does not match the observed schema.",
      "changes": [{ "kind": "drop", "field": "legacy_flag" }],
      "expected": { "decision": "block", "reasons": ["SCHEMA_MISMATCH"], "gaps": [] }
    },
    {
      "id": "drop-column-uppercase",
      "group": "compatibility",
      "rationale": "STATUS names the existing status column, so this is a destructive drop.",
      "changes": [{ "kind": "drop", "field": "STATUS" }],
      "expected": { "decision": "block", "reasons": ["DESTRUCTIVE_CHANGE"], "gaps": [] }
    },
    {
      "id": "rename-to-free-name",
      "group": "compatibility",
      "rationale": "Consumers of the old name must migrate; a person decides the compatibility window.",
      "changes": [{ "kind": "rename", "field": "order_total", "to": "gross_amount" }],
      "expected": { "decision": "review-required", "reasons": ["RENAME_CONTRACT"], "gaps": [] }
    },
    {
      "id": "rename-onto-existing-column",
      "group": "compatibility",
      "rationale": "The target name is taken; the change cannot be applied as written.",
      "changes": [{ "kind": "rename", "field": "status", "to": "order_id" }],
      "expected": { "decision": "block", "reasons": ["FIELD_EXISTS"], "gaps": [] }
    },
    {
      "id": "rename-onto-existing-column-uppercase",
      "group": "compatibility",
      "rationale": "ORDER_ID resolves to the existing order_id column.",
      "changes": [{ "kind": "rename", "field": "status", "to": "ORDER_ID" }],
      "expected": { "decision": "block", "reasons": ["FIELD_EXISTS"], "gaps": [] }
    },
    {
      "id": "rename-unknown-source",
      "group": "compatibility",
      "rationale": "The source column is not in the observed schema.",
      "changes": [{ "kind": "rename", "field": "legacy_flag", "to": "flag" }],
      "expected": { "decision": "block", "reasons": ["SCHEMA_MISMATCH"], "gaps": [] }
    },
    {
      "id": "rename-source-uppercase",
      "group": "compatibility",
      "rationale": "ORDER_TOTAL names the existing order_total column; this is an ordinary rename.",
      "changes": [{ "kind": "rename", "field": "ORDER_TOTAL", "to": "gross_amount" }],
      "expected": { "decision": "review-required", "reasons": ["RENAME_CONTRACT"], "gaps": [] }
    },
    {
      "id": "rename-same-declared-type",
      "group": "compatibility",
      "rationale": "The declared type equals the observed type, so only the name changes.",
      "changes": [
        { "kind": "rename", "field": "order_total", "to": "gross_amount", "type": "DECIMAL(12,2)" }
      ],
      "expected": { "decision": "review-required", "reasons": ["RENAME_CONTRACT"], "gaps": [] }
    },
    {
      "id": "rename-with-lossy-type",
      "group": "compatibility",
      "rationale": "The renamed column would be VARCHAR(5), which cannot hold every DECIMAL(12,2) value and changes type family.",
      "changes": [
        { "kind": "rename", "field": "order_total", "to": "gross_amount", "type": "VARCHAR(5)" }
      ],
      "expected": {
        "decision": "block",
        "reasons": ["NARROWING_TYPE", "RENAME_CONTRACT"],
        "gaps": []
      }
    },
    {
      "id": "rename-with-wider-type",
      "group": "compatibility",
      "rationale": "INT to BIGINT is lossless, but the rename and the type change both need review.",
      "changes": [{ "kind": "rename", "field": "quantity", "to": "item_count", "type": "BIGINT" }],
      "expected": {
        "decision": "review-required",
        "reasons": ["RENAME_CONTRACT", "TYPE_WIDENING"],
        "gaps": []
      }
    },
    {
      "id": "widen-int-to-bigint",
      "group": "compatibility",
      "rationale": "Every INT value fits in BIGINT on every listed platform.",
      "changes": [{ "kind": "type_change", "field": "quantity", "from": "INT", "to": "BIGINT" }],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "narrow-bigint-to-int",
      "group": "compatibility",
      "rationale": "BIGINT values above 2^31 do not fit in INT on PostgreSQL, Redshift or SQL Server.",
      "changes": [{ "kind": "type_change", "field": "order_id", "from": "BIGINT", "to": "INT" }],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "narrow-bigint-to-smallint",
      "group": "compatibility",
      "rationale": "SMALLINT holds 16-bit values on most listed platforms.",
      "changes": [{ "kind": "type_change", "field": "order_id", "from": "BIGINT", "to": "SMALLINT" }],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "widen-declared-integer-synonym",
      "group": "compatibility",
      "rationale": "INTEGER and INT are the same type, so the declared source matches the observed INT.",
      "changes": [{ "kind": "type_change", "field": "quantity", "from": "INTEGER", "to": "BIGINT" }],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "widen-decimal-precision",
      "group": "compatibility",
      "rationale": "More precision at the same scale keeps every value.",
      "changes": [
        { "kind": "type_change", "field": "order_total", "from": "DECIMAL(12,2)", "to": "DECIMAL(14,2)" }
      ],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "narrow-decimal-scale",
      "group": "compatibility",
      "rationale": "Dropping the scale rounds away cents.",
      "changes": [
        { "kind": "type_change", "field": "order_total", "from": "DECIMAL(12,2)", "to": "DECIMAL(12,0)" }
      ],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "narrow-decimal-integer-digits",
      "group": "compatibility",
      "rationale": "DECIMAL(12,4) leaves 8 integer digits where DECIMAL(12,2) had 10.",
      "changes": [
        { "kind": "type_change", "field": "order_total", "from": "DECIMAL(12,2)", "to": "DECIMAL(12,4)" }
      ],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "widen-decimal-digits-and-scale",
      "group": "compatibility",
      "rationale": "DECIMAL(16,4) has more integer digits and more scale than DECIMAL(12,2).",
      "changes": [
        { "kind": "type_change", "field": "order_total", "from": "DECIMAL(12,2)", "to": "DECIMAL(16,4)" }
      ],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "widen-number-numeric-synonyms",
      "group": "compatibility",
      "rationale": "NUMBER, NUMERIC and DECIMAL name the same exact numeric type.",
      "changes": [
        { "kind": "type_change", "field": "order_total", "from": "NUMBER(12,2)", "to": "NUMERIC(14,2)" }
      ],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "widen-varchar",
      "group": "compatibility",
      "rationale": "A longer VARCHAR keeps every value.",
      "changes": [
        { "kind": "type_change", "field": "status", "from": "VARCHAR(32)", "to": "VARCHAR(64)" }
      ],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "narrow-varchar",
      "group": "compatibility",
      "rationale": "Values longer than 16 characters would be truncated or rejected.",
      "changes": [
        { "kind": "type_change", "field": "status", "from": "VARCHAR(32)", "to": "VARCHAR(16)" }
      ],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "varchar-without-length",
      "group": "compatibility",
      "rationale": "An unsized VARCHAR is 1 character in SQL Server DDL, so the change is not lossless everywhere.",
      "changes": [{ "kind": "type_change", "field": "status", "from": "VARCHAR(32)", "to": "VARCHAR" }],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "char-to-varchar",
      "group": "compatibility",
      "rationale": "Platforms disagree on whether CHAR padding survives the cast, so values can change.",
      "changes": [
        { "kind": "type_change", "field": "status_code", "from": "CHAR(2)", "to": "VARCHAR(2)" }
      ],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "int-to-varchar",
      "group": "compatibility",
      "rationale": "A family change breaks numeric comparison and arithmetic in consumers.",
      "changes": [
        { "kind": "type_change", "field": "quantity", "from": "INT", "to": "VARCHAR(20)" }
      ],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "date-to-varchar",
      "group": "compatibility",
      "rationale": "A family change breaks date arithmetic and ordering in consumers.",
      "changes": [
        { "kind": "type_change", "field": "order_date", "from": "DATE", "to": "VARCHAR(10)" }
      ],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "decimal-to-float",
      "group": "compatibility",
      "rationale": "Binary floating point cannot represent every two-decimal amount exactly.",
      "changes": [
        { "kind": "type_change", "field": "order_total", "from": "DECIMAL(12,2)", "to": "FLOAT" }
      ],
      "expected": { "decision": "block", "reasons": ["NARROWING_TYPE"], "gaps": [] }
    },
    {
      "id": "int-to-wide-decimal",
      "group": "compatibility",
      "rationale": "Every INT value, even a 64-bit one, fits in 19 integer digits.",
      "changes": [
        { "kind": "type_change", "field": "quantity", "from": "INT", "to": "DECIMAL(19,0)" }
      ],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "timestamp-precision-widen",
      "group": "compatibility",
      "rationale": "Microsecond precision keeps every millisecond value.",
      "changes": [
        { "kind": "type_change", "field": "updated_at", "from": "TIMESTAMP(3)", "to": "TIMESTAMP(6)" }
      ],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "float-to-double",
      "group": "compatibility",
      "rationale": "A 32-bit float is exactly representable as a 64-bit double; where FLOAT is already 64-bit they are equal.",
      "changes": [
        { "kind": "type_change", "field": "discount_rate", "from": "FLOAT", "to": "DOUBLE" }
      ],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "boolean-alias",
      "group": "compatibility",
      "rationale": "BOOL is an alias of BOOLEAN, so no value changes.",
      "changes": [{ "kind": "type_change", "field": "is_test", "from": "BOOLEAN", "to": "BOOL" }],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "declared-source-type-mismatch",
      "group": "compatibility",
      "rationale": "The request believes order_total is DECIMAL(10,2) but the catalog says DECIMAL(12,2).",
      "changes": [
        { "kind": "type_change", "field": "order_total", "from": "DECIMAL(10,2)", "to": "DECIMAL(14,2)" }
      ],
      "expected": { "decision": "block", "reasons": ["SCHEMA_MISMATCH"], "gaps": [] }
    },
    {
      "id": "type-change-unknown-column",
      "group": "compatibility",
      "rationale": "The column is not in the observed schema.",
      "changes": [
        { "kind": "type_change", "field": "legacy_amount", "from": "DECIMAL(10,2)", "to": "DECIMAL(12,2)" }
      ],
      "expected": { "decision": "block", "reasons": ["SCHEMA_MISMATCH"], "gaps": [] }
    },
    {
      "id": "type-change-identity",
      "group": "compatibility",
      "rationale": "Same type on both sides; nothing is lost, and type requests still go to review.",
      "changes": [{ "kind": "type_change", "field": "quantity", "from": "INT", "to": "INT" }],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "widen-uppercase-column",
      "group": "compatibility",
      "rationale": "QUANTITY names the existing quantity column; INT to BIGINT is lossless.",
      "changes": [{ "kind": "type_change", "field": "QUANTITY", "from": "INT", "to": "BIGINT" }],
      "expected": { "decision": "review-required", "reasons": ["TYPE_WIDENING"], "gaps": [] }
    },
    {
      "id": "tighten-nullability",
      "group": "compatibility",
      "rationale": "Existing NULL values must be cleaned up and validated before NOT NULL.",
      "changes": [{ "kind": "nullable", "field": "customer_id", "to": false }],
      "expected": { "decision": "block", "reasons": ["NULLABILITY_TIGHTENING"], "gaps": [] }
    },
    {
      "id": "relax-nullability",
      "group": "compatibility",
      "rationale": "Consumers that assume NOT NULL must confirm they tolerate nulls.",
      "changes": [{ "kind": "nullable", "field": "order_id", "to": true }],
      "expected": { "decision": "review-required", "reasons": ["NULLABILITY_REVIEW"], "gaps": [] }
    },
    {
      "id": "nullability-request-unchanged",
      "group": "compatibility",
      "rationale": "quantity is already NOT NULL; a nullability request that does not tighten goes to review.",
      "changes": [{ "kind": "nullable", "field": "quantity", "to": false }],
      "expected": { "decision": "review-required", "reasons": ["NULLABILITY_REVIEW"], "gaps": [] }
    },
    {
      "id": "nullability-unknown-column",
      "group": "compatibility",
      "rationale": "The column is not in the observed schema.",
      "changes": [{ "kind": "nullable", "field": "legacy_flag", "to": true }],
      "expected": { "decision": "block", "reasons": ["SCHEMA_MISMATCH"], "gaps": [] }
    },
    {
      "id": "tighten-nullability-uppercase",
      "group": "compatibility",
      "rationale": "CUSTOMER_ID names the nullable customer_id column.",
      "changes": [{ "kind": "nullable", "field": "CUSTOMER_ID", "to": false }],
      "expected": { "decision": "block", "reasons": ["NULLABILITY_TIGHTENING"], "gaps": [] }
    },
    {
      "id": "batch-two-additions",
      "group": "batch",
      "rationale": "Two nullable additions are both additive.",
      "changes": [
        { "kind": "add", "field": "campaign_id", "type": "VARCHAR(64)", "required": false },
        { "kind": "add", "field": "channel", "type": "VARCHAR(16)", "required": false }
      ],
      "expected": {
        "decision": "proceed-with-checks",
        "reasons": ["ADDITIVE_CHANGE", "ADDITIVE_CHANGE"],
        "gaps": []
      }
    },
    {
      "id": "batch-addition-with-drop",
      "group": "batch",
      "rationale": "One blocking change blocks the whole batch.",
      "changes": [
        { "kind": "add", "field": "campaign_id", "type": "VARCHAR(64)", "required": false },
        { "kind": "drop", "field": "status" }
      ],
      "expected": {
        "decision": "block",
        "reasons": ["ADDITIVE_CHANGE", "DESTRUCTIVE_CHANGE"],
        "gaps": []
      }
    },
    {
      "id": "batch-addition-with-rename",
      "group": "batch",
      "rationale": "The rename needs review even though the addition does not.",
      "changes": [
        { "kind": "add", "field": "campaign_id", "type": "VARCHAR(64)", "required": false },
        { "kind": "rename", "field": "order_total", "to": "gross_amount" }
      ],
      "expected": {
        "decision": "review-required",
        "reasons": ["ADDITIVE_CHANGE", "RENAME_CONTRACT"],
        "gaps": []
      }
    },
    {
      "id": "batch-widening-with-relaxed-nullability",
      "group": "batch",
      "rationale": "Both changes are lossless but both need review.",
      "changes": [
        { "kind": "type_change", "field": "quantity", "from": "INT", "to": "BIGINT" },
        { "kind": "nullable", "field": "order_id", "to": true }
      ],
      "expected": {
        "decision": "review-required",
        "reasons": ["NULLABILITY_REVIEW", "TYPE_WIDENING"],
        "gaps": []
      }
    },
    {
      "id": "batch-addition-colliding-by-case",
      "group": "batch",
      "rationale": "ORDER_ID collides with order_id, so the batch cannot be applied.",
      "changes": [
        { "kind": "add", "field": "campaign_id", "type": "VARCHAR(64)", "required": false },
        { "kind": "add", "field": "ORDER_ID", "type": "BIGINT", "required": false }
      ],
      "expected": {
        "decision": "block",
        "reasons": ["ADDITIVE_CHANGE", "FIELD_EXISTS"],
        "gaps": []
      }
    },
    {
      "id": "batch-widening-with-narrowing",
      "group": "batch",
      "rationale": "The narrowing change blocks the batch.",
      "changes": [
        { "kind": "type_change", "field": "quantity", "from": "INT", "to": "BIGINT" },
        { "kind": "type_change", "field": "order_id", "from": "BIGINT", "to": "INT" }
      ],
      "expected": {
        "decision": "block",
        "reasons": ["NARROWING_TYPE", "TYPE_WIDENING"],
        "gaps": []
      }
    },
    {
      "id": "usage-unknown",
